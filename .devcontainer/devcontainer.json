// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Python 3",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"build": {"dockerfile": "Dockerfile", "context": ".."},
	"runArgs": [
        "--env-file", "${localWorkspaceFolder}/.env"
    ],

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-azuretools.vscode-docker", // Docker
				"tamasfe.even-better-toml", // Even Better TOML
				"oderwat.indent-rainbow", // indent-rainbow
				"ms-vscode.makefile-tools", // Makefile Tools
				"ms-python.python", // Python
				"redhat.vscode-yaml", // YAML
				"vscode-icons-team.vscode-icons", // vscode-icons
				"charliermarsh.ruff", // Ruff
				"ms-toolsai.jupyter" // Jupyter
			],
			"settings": {
				"editor.rulers": [88, 120],
				"python.defaultInterpreterPath": "${localWorkspaceFolder}/.venv/bin/python"
			}
		},
		"remoteEnv": {
			"PATH": "${localWorkspaceFolder}/.venv/bin:$PATH"
		}
	},

	"mounts": [
		"source=${localEnv:HOME}/.ssh,target=/root/.ssh,type=bind,consistency=cached",
		"source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
	],

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "bash $(pwd)/.devcontainer/post_create_command.sh"
	// "postCreateCommand": "poetry install && pre-commit install && echo 'source $(pwd)/.venv/bin/activate' >> $HOME/.bashrc"
	"onCreateCommand": "poetry install",
	"postCreateCommand": "$(pwd)/.devcontainer/post_create_command.sh",
	"postStartCommand": "pre-commit install"

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
